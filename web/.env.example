# Copy this file to `.env` and fill in real values — never commit `.env` itself (it's gitignored).
# Use the SAME Supabase project Android already points at (see android/local.properties) — one
# identity across TBDFit, not a separate Web-specific project. Both values below are the client-safe
# publishable pair; Supabase's security boundary is RLS, not secrecy of these two values, but they
# still stay out of git for environment hygiene (same precedent as android/local.properties).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
